  m_TableData:
  - m_Id: 3920594614546432
    m_Localized: "\u041A\u0440\u0430\u0441\u0438\u0432\u0430\u044F \u043F\u0430\u0440\u0438\u043A\u043C\u0430\u0445\u0435\u0440\u0448\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3920758037213184
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u0441\u0432\u0435\u0442\u043B\u044B\u0439
      \u0445\u0432\u043E\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 3920759836569600
    m_Localized: "\u041A\u0440\u0430\u0441\u043D\u0430\u044F \u0440\u0443\u0431\u0430\u0448\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3920761677869056
    m_Localized: "\u042F\u0440\u043A\u0438\u0439 \u043C\u0430\u043A\u0438\u044F\u0436
      \u0438 \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u043F\u043E\u043C\u0430\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3922323250802688
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3923705492074496
    m_Localized: "\u0414\u0435\u043D\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 4123387648471040
    m_Localized: "\u0413\u041E\u0422\u041E\u0412\u042B?"
    m_Metadata:
      m_Items: []
  - m_Id: 4123390039224320
    m_Localized: "\u041D\u0410\u0427\u0410\u041B\u0418!"
    m_Metadata:
      m_Items: []
  - m_Id: 4128179976335360
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442... \u042F \u0420\u0438\u043D.\r\n\u0425\u043E\u0434\u044F\u0442
      \u0441\u043B\u0443\u0445\u0438, \u0447\u0442\u043E \u043C\u043E\u0439 \u043C\u0443\u0436
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044F \u0441 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0436\u0435\u043D\u0449\u0438\u043D\u043E\u0439...\r\n\u041D\u043E \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u043A\u0442\u043E \u043E\u043D\u0430.\r\n\u042F
      \u043D\u0435 \u0445\u043E\u0447\u0443 \u0432 \u044D\u0442\u043E \u0432\u0435\u0440\u0438\u0442\u044C,
      \u043D\u043E \u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044C
      \u043D\u0430 \u044D\u0442\u043E \u0433\u043B\u0430\u0437\u0430 \u043D\u0435
      \u043C\u043E\u0433\u0443...\r\n\u041D\u0435 \u043C\u043E\u0433\u043B\u0438
      \u0431\u044B \u0432\u044B \u043F\u043E\u043C\u043E\u0447\u044C \u043C\u043D\u0435
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0432 \u044D\u0442\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4591090335150080
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 4591114427232256
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 4591569198837760
    m_Localized: "\u0425\u043E\u0442\u0438\u0442\u0435 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0443\u0437\u043D\u0430\u0442\u044C, \u043A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 8636835581325312
    m_Localized: "\u041A\u0430\u0442-\u0441\u0446\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8639798299258880
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u043E\u0433\u043E
      \u0432 \u043A\u0440\u0430\u0441\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 8660286245367808
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043C\u044F\u0443!\n\u0421\u043A\u0443\u043C\u0431\u0440\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0431\u0430\u0431\u0443\u0448\u043A\u0430
      \u043A\u0443\u043F\u0438\u043B\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0443\u0442\u0440\u043E\u043C, \u043F\u0440\u043E\u043F\u0430\u043B\u0430.\n\u042F
      \u0443\u0441\u043F\u0435\u043B \u0441\u044A\u0435\u0441\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0434\u0438\u043D \u043A\u0443\u0441\u043E\u0447\u0435\u043A, \u0430
      \u043F\u043E\u0442\u043E\u043C \u043E\u043D\u0430 \u0432\u0434\u0440\u0443\u0433
      \u0438\u0441\u0447\u0435\u0437\u043B\u0430!\n\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
      \u0435\u0451 \u0443\u043A\u0440\u0430\u043B\u0430 \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
      \u043A\u043E\u0448\u043A\u0430!\n\u0411\u0430\u0431\u0443\u0448\u043A\u0430,
      \u043F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u043C\u043D\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F?
      \u041C\u044F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 8660663799836672
    m_Localized: "\u0412 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0447\u0451\u0440\u043D\u0430\u044F
      \u0448\u0435\u0440\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 8660665267843072
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0438\u0435 \u043A\u0440\u0443\u0433\u043B\u044B\u0435
      \u0433\u043B\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 8660666819735552
    m_Localized: "\u0420\u043E\u0437\u043E\u0432\u044B\u0439 \u043D\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 8660668329684992
    m_Localized: "\u0416\u0451\u043B\u0442\u044B\u0435 \u0432\u043D\u0435\u0448\u043D\u0438\u0435
      \u043A\u0440\u0443\u0433\u0438 \u0432\u043E\u043A\u0440\u0443\u0433 \u0433\u043B\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 8662035735703552
    m_Localized: "\u041D\u0410\u0416\u041C\u0418\u0422\u0415 \u041F\u0420\u041E\u0411\u0415\u041B,
      \u0427\u0422\u041E\u0411\u042B \u041F\u0420\u041E\u0414\u041E\u041B\u0416\u0418\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 8662607868129280
    m_Localized: "\u041D\u041E\u0412\u041E\u0415 \u0421\u041E\u0411\u042B\u0422\u0418\u0415!"
    m_Metadata:
      m_Items: []
  - m_Id: 8662609478742016
    m_Localized: "\u041A\u041E\u0428\u041A\u0410 \u0423\u041A\u0420\u0410\u041B\u0410
      \u0415\u0414\u0423"
    m_Metadata:
      m_Items: []
  - m_Id: 8662610770587648
    m_Localized: "\u041D\u0415 \u0414\u0410\u0419\u0422\u0415 \u0415\u0419 \u0423\u041A\u0420\u0410\u0421\u0422\u042C
      \u0415\u0414\u0423!"
    m_Metadata:
      m_Items: []
  - m_Id: 8662612028878848
    m_Localized: "\u0411\u0420\u041E\u0421\u042C\u0422\u0415 \u0415\u0419 \u041B\u0410\u041A\u041E\u041C\u0421\u0422\u0412\u041E!"
    m_Metadata:
      m_Items: []
  - m_Id: 8662613303947264
    m_Localized: "\u041B\u0410\u0414\u041D\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 8870925081440256
    m_Localized: "\u0423\u043C\u043D\u044B\u0439 \u0438 \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 244973498368
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 387776966656
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 389840564224
    m_Localized: "\u0412\u044B\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 15393226682368
    m_Localized: "\u041D\u0410\u0421\u0422\u0420\u041E\u0419\u041A\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 15471404314624
    m_Localized: "\u0427\u0423\u0412\u0421\u0422\u0412\u0418\u0422\u0415\u041B\u042C\u041D\u041E\u0421\u0422\u042C
      \u041A\u0410\u041C\u0415\u0420\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 15602262405120
    m_Localized: "\u041F\u041B\u0410\u0412\u041D. \u041A\u0410\u041C\u0415\u0420\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 15619844927488
    m_Localized: "\u0418\u041D\u0415\u0420\u0426\u0418\u042F \u041A\u0410\u041C\u0415\u0420\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 15633379946496
    m_Localized: "\u041E\u0411\u0429\u0410\u042F \u0413\u0420\u041E\u041C\u041A\u041E\u0421\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 15684525289472
    m_Localized: "\u0413\u0420\u041E\u041C\u041A\u041E\u0421\u0422\u042C \u042D\u0424\u0424\u0415\u041A\u0422\u041E\u0412"
    m_Metadata:
      m_Items: []
  - m_Id: 15697376636928
    m_Localized: "\u0413\u0420\u041E\u041C\u041A\u041E\u0421\u0422\u042C \u041C\u0423\u0417\u042B\u041A\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 15714984325120
    m_Localized: "\u0420\u0410\u0417\u0420\u0415\u0428\u0415\u041D\u0418\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 15730574553088
    m_Localized: "\u0420\u0415\u0416\u0418\u041C \u042D\u041A\u0420\u0410\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 15747016224768
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 19481414791168
    m_Localized: "\u0423\u041B\u0418\u041A\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 1701217882271744
    m_Localized: "\u042F\u0417\u042B\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 2051116100415488
    m_Localized: "\u041E\u0428\u0418\u0411\u041A\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 2819991456903168
    m_Localized: "\u0417\u0412\u0423\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 2837389631221760
    m_Localized: "\u041A\u0410\u041C\u0415\u0420\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 24594573357056
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 \u0441\u0432\u043E\u044E \u043B\u0430\u0432\u043A\u0443 \u043C\u0430\u043B\u0430!\r\n\u0416\u0430\u0440\u044C\u0442\u0435
      \u0448\u0430\u0448\u043B\u044B\u0447\u043A\u0438 \u0438 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0435\u0439.\r\n\u041D\u043E
      \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439\u0442\u0435 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u0443\u0448\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438...\r\n\u0417\u0434\u0435\u0441\u044C
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0435!\r\n\u0417\u0430
      \u0440\u0430\u0431\u043E\u0442\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 3151803794255872
    m_Localized: "\u0410\u0412\u0422\u041E\u0420\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 3883540157493248
    m_Localized: "\u041E\u0411\u0423\u0427\u0415\u041D\u0418\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 3887083253854208
    m_Localized: "\u0416\u0410\u0420\u042C\u0422\u0415!"
    m_Metadata:
      m_Items: []
  - m_Id: 3887155752398848
    m_Localized: "\u041F\u0415\u0420\u0415\u0412\u0415\u0420\u041D\u0418\u0422\u0415,
      \u0427\u0422\u041E\u0411\u042B \u041E\u0411\u0416\u0410\u0420\u0418\u0422\u042C
      \u0421 \u041E\u0411\u0415\u0418\u0425 \u0421\u0422\u041E\u0420\u041E\u041D!"
    m_Metadata:
      m_Items: []
  - m_Id: 3887196332290048
    m_Localized: "\u0414\u041E\u0411\u0410\u0412\u042C\u0422\u0415 \u0421\u041E\u0423\u0421!"
    m_Metadata:
      m_Items: []
  - m_Id: 3887253366435840
    m_Localized: "\u041D\u0430\u043D\u043E\u0441\u0438\u0442\u0435 \u0441\u043E\u0443\u0441
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\u043C\u0438 \u0432\u0432\u0435\u0440\u0445
      \u0438 \u0432\u043D\u0438\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 3887309519777792
    m_Localized: "\u0414\u041E\u0411\u0410\u0412\u042C\u0422\u0415 \u041E\u0421\u0422\u0420\u041E\u0422\u042B!"
    m_Metadata:
      m_Items: []
  - m_Id: 3887313588252672
    m_Localized: "\u0412\u0441\u0442\u0440\u044F\u0445\u043D\u0438\u0442\u0435 \u0431\u0443\u0442\u044B\u043B\u043E\u0447\u043A\u0443
      \u0441 \u0447\u0438\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 3887436661714944
    m_Localized: "\u041F\u041E\u0420\u0410 \u041F\u041E\u0414\u0410\u0412\u0410\u0422\u042C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3903794673807360
    m_Localized: "\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0438\u0442\u0435 3-\u0433\u043E
      \u0443\u0440\u043E\u0432\u043D\u044F \u043E\u0441\u0442\u0440\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3903793298075648
    m_Localized: "\u041D\u0430\u043D\u0435\u0441\u0438\u0442\u0435 \u0441\u043E\u0443\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 3903791733600256
    m_Localized: "\u0416\u0430\u0440\u044C\u0442\u0435 \u0448\u0430\u0448\u043B\u044B\u0447\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3903744912584704
    m_Localized: "\u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435
      \u043A\u0430\u043C\u0435\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3888661675307008
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043A\u043B\u0430\u0432\u0438\u0448\u0438 WASD \u0438\u043B\u0438 \u0437\u0430\u0436\u043C\u0438\u0442\u0435
      \u043F\u0440\u0430\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438
      \u0438 \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 3888625138724864
    m_Localized: "\u041E\u0421\u041C\u041E\u0422\u0420\u0418\u0422\u0415\u0421\u042C!"
    m_Metadata:
      m_Items: []
