    m_Localized: Cutscene
    m_Metadata:
      m_Items: []
  - m_Id: 8639798299258880
    m_Localized: Choose the Red Suspect
    m_Metadata:
      m_Items: []
  - m_Id: 8660286245367808
    m_Localized: "Hello, meow!\nThe mackerel Grandma bought this morning is missing.
      \nI only had one bite, then it suddenly disappeared!\nA cat must have stolen
      it!\nCould you help me investigate, Grandma? Meow!\n"
    m_Metadata:
      m_Items: []
  - m_Id: 8660663799836672
    m_Localized: Mostly black fur.
    m_Metadata:
      m_Items: []
  - m_Id: 8660665267843072
